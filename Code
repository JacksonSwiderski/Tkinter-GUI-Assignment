import tkinter as tk
from PIL import Image, ImageTk

root = tk.Tk()
root.title("Cool GUI Program")
root.geometry('600x400')
root.attributes("-fullscreen", True)
root.configure(bg = 'DarkGrey')

# BASIC FUNCTIONS

def enter_fs(event=None):
    root.attributes("-fullscreen", True)


def exit_fs(event=None):
    root.attributes("-fullscreen", False)


root.bind('<F11>', enter_fs)
root.bind('<Escape>', exit_fs)

# INTRO ANIMATION
# Intro Frame
intro_frame = tk.Frame(root, bg = 'DarkGrey')
intro_frame.pack(fill = 'both', expand = True)

intro_image = Image.open('js_logo.png')
intro_image = intro_image.resize((600, 600))
logo_image = ImageTk.PhotoImage(intro_image)

logo_label = tk.Label(intro_frame, image = logo_image, bg = 'DarkGrey')


root.mainloop()
