unit_options = ['Imperial System', 'Metric System']

def change_unit_menu(selection):
    global unit_system, conv_options, kine_options1, kine_options2
    play_whoop()
    print(f'Current unit system: {selection}.')
    if selection == 'Imperial System':
        unit_system = 'imperial'
        print(f'System selected: {unit_system}')
    elif selection == 'Metric System':
        unit_system = 'metric'
        print(f'System selected: {unit_system}')
    else:
        unit_system = 'undefined'
        print('System not selected.')

    if unit_system == 'imperial':
        conv_options = ['ft/s to mph', 'mph to ft/s']
    elif unit_system == 'metric':
        conv_options = ['m/s to km/h', 'km/h to m/s']
    else:
        conv_options = ['Select Unit System']
    conv_select.configure(values=conv_options)
    conv_select.set('Select a Conversion')

    kine_options1 = ['Speed/Velocity', 'Time', 'Distance/Displacement', 'Acceleration']
    kine_select1.configure(values=kine_options1)
    kine_select1.set('Select a Measure')

    if unit_system == 'imperial':
        kine_options2 = ['ft/s', 'mph']
    elif unit_system == 'metric':
        kine_options2 = ['m/s', 'km/h']
    else:
        kine_options2 = ['Select Unit System']
    kine_select2.configure(values=kine_options2)
    kine_select2.set('Select a Measure')

