def convert():
    selected = conv_select.get()
    if selected == 'ft/s to mph':
        try:
            conv_value = float(conv_entry.get())
            print(f'Entry: {conv_value}')
            result = round(conv_value / 1.467, 2)
            conv_result.configure(text=f'{result} mph')
        except:
            print('Invalid Input')
            conv_result.configure(text='Invalid Input')
    elif selected == 'mph to ft/s':
        try:
            conv_value = float(conv_entry.get())
            print(f'Entry: {conv_value}')
            result = round(conv_value * 1.467, 2)
            conv_result.configure(text=f'{result} ft/s')
        except:
            print('Invalid Input')
            conv_result.configure(text='Invalid Input')
    elif selected == 'm/s to km/h':
        try:
            conv_value = float(conv_entry.get())
            print(f'Entry: {conv_value}')
            result = round(conv_value * 3.6, 2)
            conv_result.configure(text=f'{result} km/h')
        except:
            print('Invalid Input')
            conv_result.configure(text='Invalid Input')
    elif selected == 'km/h to m/s':
        try:
            conv_value = float(conv_entry.get())
            print(f'Entry: {conv_value}')
            result = round(conv_value / 3.6, 2)
            conv_result.configure(text=f'{result} m/s')
        except:
            print('Invalid Input')
            conv_result.configure(text='Invalid Input')
    else:
        conv_result.configure(text='Please select a conversion.')

