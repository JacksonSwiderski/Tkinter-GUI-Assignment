# INTRO ANIMATION

def fade_in(step=0):
    if step > 100:
        return

    img = intro_image.copy().convert('RGBA')
    alpha = int(255 * (step / 100))
    img.putalpha(alpha)

    tk_logo_image = ImageTk.PhotoImage(img)

    logo_label.configure(image=tk_logo_image)
    logo_label.image = tk_logo_image  # prevent garbage collection

    root.after(30, fade_in, step + 5)

def fade_text(step=0):
    if step > 100:
        root.after(1500, fade_out)
        return

    gray_val = int(255 * (step / 100))
    color = f'#{gray_val:02x}{gray_val:02x}{gray_val:02x}'

    intro_text.configure(text_color=color)

    root.after(30, fade_text, step + 5)

def fade_out(step=100):
    if step < 0:
        intro_frame.destroy()
        welcome_frame.pack(fill='both', expand=True)
        return

    img = intro_image.copy().convert('RGBA')
    alpha = int(255 * (step / 100))
    img.putalpha(alpha)

    tk_logo_image = ImageTk.PhotoImage(img)

    logo_label.configure(image=tk_logo_image)
    logo_label.image = tk_logo_image

    root.after(30, fade_out, step - 10)

